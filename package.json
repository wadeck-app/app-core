{
  "name": "@wadeck-app/app-core-workspace",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/frontend-shell && npm run build --workspace=packages/server && npm run build --workspace=packages/app-core-sdk && npm run build --workspace=packages/app-core-cli",
    "typecheck:tests": "npm run typecheck:tests --workspace=packages/server",
    "test": "npm run test --workspace=packages/server",
    "test:app": "npm run test --workspace=packages/frontend-shell",
    "test:sdk": "npm run test --workspace=packages/app-core-sdk",
    "test:cli": "npm run test --workspace=packages/app-core-cli",
    "test:all": "npm run test && npm run test:app && npm run test:sdk && npm run test:cli",
    "test:violations-rules": "vitest run --config .violations/vitest.config.ts",
    "copy-app": "node scripts/copy-app.mjs",
    "build:full": "npm run build && npm run copy-app"
  },
  "devDependencies": {
    "@wadeck-app/app-core-sdk": "*",
    "@wadeck-app/violations-rules": "latest",
    "typescript": "^5.3.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@wadeck-app/dsl-renderer": "^2026.10.11-088-9ca394bf",
    "@wadeck-app/dsl-ui": "^2026.10.11-088-9ca394bf"
  }
}
