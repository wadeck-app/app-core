{
  "id": "slot-contributor-a",
  "requires": { "slot-provider": "^1.0.0" },
  "extensionPoints": [
    {
      "kind": "widget",
      "slot": "dashboard",
      "label": "Contributor A dashboard widget (not part of the shared slot)",
      "view": { "type": "inline", "value": { "$type": "Badge", "label": "contributor-a-own-widget" } }
    },
    {
      "kind": "widget",
      "slot": "slot-provider:shared-slot",
      "label": "Contributor A, order 20",
      "order": 20,
      "view": { "type": "inline", "value": { "$type": "Badge", "label": "contributor-a" } }
    }
  ]
}
