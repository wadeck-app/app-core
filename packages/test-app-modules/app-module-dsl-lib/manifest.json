{
  "version": "1.0.0",
  "backendEntryPath": "./api-backend/backend.mjs",
  "extensionPoints": [
    {
      "kind": "page",
      "slot": "nav",
      "label": "DslLib Home",
      "view": { "type": "path", "value": "./dsl-frontend/home.yaml" }
    },
    {
      "kind": "page",
      "slot": "route",
      "path": "/items/:id",
      "view": { "type": "path", "value": "./dsl-frontend/item.yaml" }
    }
  ],
  "dslLib": {
    "entry": "./dsl-lib/entries.mjs",
    "css": "./dsl-lib/style.css",
    "shared": { "react": "^19", "react-router-dom": "^7", "@wadeck-app/dsl-ui": ">=2026.10.14-0" }
  }
}
