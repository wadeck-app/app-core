{
  "name": "@wadeck-app/app-core-sdk",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.bundle.js",
  "types": "./dist/index.bundle.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.bundle.d.ts",
      "import": "./dist/index.bundle.js",
      "default": "./dist/index.bundle.js"
    },
    "./register": {
      "types": "./dist/register.bundle.d.ts",
      "import": "./dist/register.bundle.js",
      "default": "./dist/register.bundle.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "register": ["dist/register.bundle.d.ts"]
    }
  },
  "files": [
    "dist/index.bundle.js",
    "dist/index.bundle.d.ts",
    "dist/register.bundle.js",
    "dist/register.bundle.d.ts",
    "README.md",
    "docs/module-authoring.md",
    "docs/registering-a-module.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json && node scripts/bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^22.10.2",
    "@wadeck-app/app-core-server": "*",
    "esbuild": "^0.28.2",
    "rollup": "^4.64.5",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22"
  }
}
